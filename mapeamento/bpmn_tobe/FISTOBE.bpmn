<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_FISTOBE" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_FISTOBE">
    <bpmn:participant id="Part_FISTOBE" name="FISTOBE — Fiscalizações programadas anuais de saneamento — TO-BE proposto (AS-IS)" processRef="Processo_FISTOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_FISTOBE" isExecutable="false">
    <bpmn:documentation>Do cronograma anual priorizado juntado ao processo às vistorias da CASAN nas unidades da concessionária, ao relatório conferido e aprovado em fluxo contínuo, ao ofício gerado no 'De acordo', à análise da resposta de cada relatório no prazo interno, à escalada de pendências, ao parecer anual de consolidação e, se houver contestação, à resposta pela tese-padrão e ao envio à Procuradoria só de questão jurídica nova Fontes: Proposta sobre o modelo AS-IS (mapeamento/modelo_FIS.json) e as melhorias de mapeamento/melhorias_FIS.json; estudo de caso único (SEI-480002/001314/2024). Tarefas da raia SIS são novas e não entram na simulação; o efeito simulado está em mapeamento/resultado_tobe_FIS.json.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_FISTOBE">
      <bpmn:lane id="Lane_CODIR" name="Conselho-Diretor (CODIR, AGENERSA/CD)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SIS" name="Painel e rotinas sobre o SEI (tarefas automáticas)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN): equipe de fiscalização e gerência">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SECEX" name="Secretaria Executiva (SECEX)">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária Águas do Rio – Bloco 1">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Deliberação determina vistorias anuais por concessionária">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Elaborar cronograma anual priorizado e juntá-lo ao processo">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Enviar Aviso de Fiscalização com antecedência mínima">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Vistoriar unidade com checklist digital do tipo de unidade">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Redigir relatório no modelo padrão dentro da meta interna">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Conferir forma do relatório antes da assinatura">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Revisar e dar o 'De acordo' em fluxo contínuo">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Assinar ofício gerado no 'De acordo' e enviar por e-mail">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Resposta por não conformidade recebida no formulário">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Analisar a resposta do relatório no prazo interno">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Não conformidade pendente após o prazo?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t9" name="Aplicar a regra de escalada da pendência">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Atualizar painel de pendências e alertas por unidade">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="Consolidar o parecer anual a partir das análises">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Dar ciência do parecer à concessionária">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Manifestação da concessionária sobre o parecer recebida">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Concessionária contesta o parecer?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t13" name="Responder com a tese-padrão sobre o escopo">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="Submeter à Procuradoria só questão jurídica nova">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t15" name="Analisar fundamentos jurídicos da fiscalização">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Questão jurídica respondida">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f2" name="Recomendações seguem em acompanhamento no painel">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="t4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="t4" targetRef="t5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="t5" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="t7" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="e1" targetRef="t8"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="t8" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" name="Não" sourceRef="g1" targetRef="t10"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="Sim" sourceRef="g1" targetRef="t9"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" name="Vistoria de retorno" sourceRef="t9" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="t10" targetRef="t11"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="t11" targetRef="t12"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="t12" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="e2" targetRef="g2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" name="Sim" sourceRef="g2" targetRef="t13"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" name="Não" sourceRef="g2" targetRef="f2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="t13" targetRef="t14"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F20" sourceRef="t14" targetRef="t15"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F21" sourceRef="t15" targetRef="f1"></bpmn:sequenceFlow>
  </bpmn:process>
