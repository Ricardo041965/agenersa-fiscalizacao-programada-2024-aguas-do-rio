<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_FIS" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_FIS">
    <bpmn:participant id="Part_FIS" name="FIS — Fiscalizações programadas anuais de saneamento (AS-IS)" processRef="Processo_FIS" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_FIS" isExecutable="false">
    <bpmn:documentation>Da determinação do Conselho-Diretor de vistorias anuais por concessionária às vistorias da CASAN nas unidades da Águas do Rio – Bloco 1, ao envio dos relatórios por ofício, ao parecer anual sobre as providências da concessionária e ao encaminhamento à Procuradoria após a contestação do parecer Fontes: Estudo de caso único: SEI-480002/001314/2024 (AGENERSA/RJ, fiscalizações programadas 2024 da CASAN na Águas do Rio – Bloco 1), PDF exportado, fichas por documento, linha do tempo e fatos calculados por script. Cada relatório é um caso do subprocesso vistoria, relatório, aprovação e ofício; a análise das respostas tem um único caso (parecer anual). Ficaram fora como tarefa: os e-mails de envio (entram na saída dos ofícios) e o despacho de encaminhamento da CASAN à SECEX (entra na saída do parecer). Não estão no PDF e foram inferidos do despacho da SECEX e do parecer: as respostas da concessionária, a ciência do parecer, a manifestação da concessionária e a reiteração da CASAN. Do mesmo tipo que o P06 do repositório.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_FIS">
      <bpmn:lane id="Lane_CODIR" name="Conselho-Diretor (CODIR, AGENERSA/CD)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN): equipe de fiscalização e gerência">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SECEX" name="Secretaria Executiva (SECEX)">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária Águas do Rio – Bloco 1">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Deliberação determina vistorias anuais por concessionária">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Agendar vistorias com a concessionária">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Vistoriar unidade e elaborar relatório">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Aprovar relatório de fiscalização">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Encaminhar lote de relatórios por ofício">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Obra ou pendência exige nova vistoria?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e1" name="Respostas e cronogramas da concessionária recebidos">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Analisar providências e emitir parecer anual">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Dar ciência do parecer à concessionária">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Manifestação da concessionária sobre o parecer recebida">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Concessionária contesta o parecer?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Reanalisar manifestação e reiterar parecer">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Submeter questionamento jurídico à Procuradoria">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Analisar fundamentos jurídicos da fiscalização">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo em análise jurídica (fim do recorte)">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="f2" name="Recomendações seguem em acompanhamento">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="t4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="t4" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="Não" sourceRef="g1" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="Sim: vistoria de acompanhamento" sourceRef="g1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="e1" targetRef="t5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="t5" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="t6" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="e2" targetRef="g2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="Sim" sourceRef="g2" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" name="Não" sourceRef="g2" targetRef="f2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="t7" targetRef="t8"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="t8" targetRef="t9"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="t9" targetRef="f1"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_FIS">
    <bpmndi:BPMNPlane id="Plane_FIS" bpmnElement="Colab_FIS">
      <bpmndi:BPMNShape id="Part_FIS_di" bpmnElement="Part_FIS" isHorizontal="true">
